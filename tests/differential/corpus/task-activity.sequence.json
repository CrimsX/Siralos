{
  "id": "task-activity.sequence",
  "subject": "task-contract",
  "platforms": ["*"],
  "parity": "required",
  "env": {},
  "input": {
    "now": 1700000000000,
    "contract": {
      "id": "task-1",
      "request": "Add a health component",
      "context": "Implement within the workspace.",
      "constraints": [
        {
          "id": "scope",
          "kind": "scope",
          "description": "Workspace only."
        }
      ],
      "acceptanceCriteria": [
        {
          "id": "parses",
          "description": "GDScript parses.",
          "verificationKind": "deterministic"
        }
      ],
      "pausePolicy": "none"
    },
    "steps": [
      {
        "id": "s1",
        "description": "Implement the component",
        "kind": "implementation",
        "accepts": ["workspace_read"]
      },
      {
        "id": "s2",
        "description": "Verify the change",
        "kind": "implementation",
        "accepts": ["parser_result", "validation_result", "review_result"]
      }
    ],
    "ops": [
      {
        "op": "transitionPhase",
        "phase": "working"
      },
      {
        "op": "beginStep",
        "stepId": "s1"
      },
      {
        "op": "failStep",
        "stepId": "s1",
        "reason": "first attempt failed"
      },
      {
        "op": "beginStep",
        "stepId": "s1"
      },
      {
        "op": "attachEvidence",
        "id": "e1",
        "kind": "workspace_read",
        "source": {
          "type": "workspace_read",
          "paths": ["project.godot"]
        },
        "verification": {
          "checkId": "parses",
          "criterionId": "parses",
          "outcome": "passed"
        }
      },
      {
        "op": "completeStep",
        "stepId": "s1",
        "refs": [
          {
            "evidenceId": "e1",
            "kind": "workspace_read"
          }
        ]
      },
      {
        "op": "verifyCriterion",
        "criterionId": "parses",
        "verifiedBy": "e1"
      },
      {
        "op": "submitDisposition",
        "disposition": {
          "type": "continue",
          "nextAction": "proceed"
        },
        "source": "host"
      },
      {
        "op": "submitDisposition",
        "disposition": {
          "type": "blocked",
          "reason": "waiting for user"
        },
        "source": "model"
      },
      {
        "op": "submitDisposition",
        "disposition": {
          "type": "complete"
        },
        "source": "host"
      },
      {
        "op": "setValidationStatus",
        "status": "clean"
      },
      {
        "op": "setReviewStatus",
        "status": "clean"
      },
      {
        "op": "completeTask"
      }
    ]
  }
}

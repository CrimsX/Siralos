# The differential harness is its own excluded workspace, so it gets its own
# target dir. The root-anchored /target/ above does not match it — and the
# differential audit walks untracked files, so an unignored build tree makes
# the audit fail its byte bound.
/harness/target/
/tests/differential/out/
/reports/
/audit/
/audits/
/fuzz/target/
/fuzz/artifacts/
/fuzz/corpus/

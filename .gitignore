.agents
node_modules/
dist/
coverage/
*.tsbuildinfo
*.log
*.tmp
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
.idea/
.vscode/
.vs/
/target/
# The differential harness is its own excluded workspace, so it gets its own
# target dir. The root-anchored /target/ above does not match it — and the
# differential audit walks untracked files, so an unignored build tree makes
# the audit fail its byte bound.
/harness/target/
/tests/differential/out/
/reports/
/audit/
/audits/
/fuzz/target/
/fuzz/artifacts/
/fuzz/corpus/
/experiments/**/target/
/experiments/**/guest.component.wasm
# Ad-hoc build directories created during verification runs.
/target-local/
/target-profile-aba*/
/target-snapshot-agent/
*.rmeta

# User-local Siralos session data (provider config, recordings store, resolved lock).
# Nested matches cover workspaces rooted inside this repository; a separate
# workspace repository must apply its own ignore rule.
**/siralos.toml
/siralos.lock
/.siralos/

# Planning scaffolding for the 1.0 work (deleted at handoff).
/.plan/

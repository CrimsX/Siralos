{
  "name": "siralos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check:identity": "node scripts/check-siralos-identity.mjs",
    "check:public": "node scripts/check-public-hygiene.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:context": "node scripts/check-project-context.mjs",
    "check:rust": "node scripts/check-rust-architecture.mjs",
    "check:differential": "node tests/differential/run-differential.mjs --corpus tests/differential/corpus --root . --out-dir tests/differential/out",
    "check:differential:live": "node tests/differential/run-differential.mjs --corpus tests/differential/corpus --root . --out-dir tests/differential/out --pinned-oracle tests/differential/evidence/typescript-freeze-v32/oracle.json",
    "check:rust-format": "cargo fmt --all --check",
    "check:rust-clippy": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "test:rust": "cargo test --workspace --all-targets --all-features --locked",
    "check:rust-all": "npm run check:rust && npm run check:differential && npm run check:rust-format && npm run check:rust-clippy && npm run test:rust",
    "check": "npm run format:check && npm run lint && npm run check:docs && npm run check:context && npm run check:identity && npm run check:public && npm run check:rust-all",
    "siralos": "cargo run --locked --bin siralos --",
    "build:domain-conformance": "node scripts/domain/build-conformance-guests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}

{
  "name": "solaris",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:sandbox": "npm run build && node scripts/sandbox/run-conformance.mjs",
    "test:godot": "npm run build && node scripts/sandbox/run-godot-conformance.mjs",
    "test:godot-recovery": "npm run build && node scripts/sandbox/run-godot-recovery-conformance.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:architecture",
    "solaris": "npm run build && node apps/cli/dist/index.js",
    "test:godot-diagnostics": "npm run build && node scripts/sandbox/run-godot-diagnostics-conformance.mjs",
    "test:godot-lsp": "npm run build && node scripts/sandbox/run-godot-lsp-conformance.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.70"
  }
}
